{
  "name": "alsha-group-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/input.css -o ./src/main/resources/static/css/site.css --minify",
    "watch:css": "tailwindcss -i ./frontend/input.css -o ./src/main/resources/static/css/site.css --watch",
    "vendor": "node scripts/copy-vendor.cjs",
    "build": "npm run vendor && npm run build:css",
    "test": "node --test scripts/site.test.cjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "@fortawesome/fontawesome-free": "6.4.0",
    "jsdom": "26.1.0"
  }
}
